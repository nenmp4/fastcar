# Banco de produção — NUNCA versionar (mesma regra do JurídicoSaaS)
database/*.db
database/*.db-shm
database/*.db-wal

storage/logs/*
storage/backups/*
storage/uploads/*
!storage/logs/.gitkeep
!storage/backups/.gitkeep
!storage/uploads/.gitkeep

# Lock de execução do cron/followup.php (flock) — nunca tem conteúdo
# relevante, só existe pra travar rodadas sobrepostas.
storage/followup.lock

# Credencial da service account do Google Drive (JSON) — NUNCA versionar.
# Cai em config/, protegido por .htaccess (Deny from all) igual ao JurídicoSaaS.
# Drop manual do arquivo real via FTP/SSH quando a service account existir.
config/google_drive_credentials.json

.DS_Store
