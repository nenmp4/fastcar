# Banco de produção — NUNCA versionar (mesma regra do JurídicoSaaS)
database/*.db
database/*.db-shm
database/*.db-wal

storage/logs/*
storage/backups/*
storage/uploads/*
!storage/logs/.gitkeep
!storage/backups/.gitkeep
!storage/uploads/.gitkeep

# Fotos de perfil enviadas pelos usuários (admin/meu_perfil.php) — dado
# pessoal por conta, nunca versionado, mesmo espírito de storage/uploads/.
admin/assets/avatars/*
!admin/assets/avatars/.gitkeep

# Lock de execução dos crons que mandam WhatsApp (flock) — nunca tem
# conteúdo relevante, só existe pra travar rodadas sobrepostas.
storage/followup.lock
storage/resumo_produtividade.lock

# Credencial da service account do Google Drive (JSON) — NUNCA versionar.
# Cai em config/, protegido por .htaccess (Deny from all) igual ao JurídicoSaaS.
# Drop manual do arquivo real via FTP/SSH quando a service account existir.
config/google_drive_credentials.json

.DS_Store
